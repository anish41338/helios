__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Regenerable model weights (large, random).
artifacts/bench_model/

# Downloaded HuggingFace checkpoints. Never commit these: Qwen2.5-0.5B alone is
# ~1 GB, GitHub rejects single files over 100 MB, and they are reproducible with
# one snapshot_download call.
artifacts/qwen05b/
artifacts/*.safetensors
artifacts/**/*.safetensors

# Per-run benchmark records are regenerable via bench/loadgen.py. The DST
# sweep logs are deliberately NOT ignored: spec section 19.3 requires every
# claim to trace to an artifact, and docs/DST.md cites them.
artifacts/helios_*.json
artifacts/baseline_*.json

# Chart PNGs are build outputs of bench/make_report.py and are embedded in the
# committed PDF, so tracking them would store the same pixels twice.
artifacts/figures/

# The alpha measurements are NOT ignored, for the same reason as the DST logs:
# docs/QASSD.md and the PDF report both cite specific numbers from them, and
# reproducing them costs ~9 minutes plus a 1 GB checkpoint download.
!artifacts/alpha.json
!artifacts/alpha_rtn.json
!artifacts/alpha_significance.json
